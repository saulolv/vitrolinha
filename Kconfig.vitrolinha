# Opções próprias do Vitrolinha.
#
# Separadas do Kconfig da raiz para que os testes possam incluí-las sem
# incluir uma segunda vez o Kconfig.zephyr: o teste que precisa de uma opção
# daqui tem um Kconfig de duas linhas que faz `rsource` deste arquivo.

menu "Vitrolinha"

choice VITROLINHA_STORAGE
	prompt "Origem da biblioteca"
	default VITROLINHA_STORAGE_FAKE if BOARD_NATIVE_SIM
	default VITROLINHA_STORAGE_CARD
	help
	  Quem responde ao contrato de include/vitrolinha/storage.h.

	  Na placa é o cartão. No simulador é a implementação de mentira: lá
	  não há disco registrado, o cartão é sempre "ausente", e sem as faixas
	  embutidas as trilhas de áudio e de interface ficariam sem biblioteca
	  para tocar e desenhar.

config VITROLINHA_STORAGE_CARD
	bool "Cartao microSD"
	depends on FAT_FILESYSTEM_ELM
	help
	  Varre as faixas da raiz do volume montado pelo módulo card: RTTTL
	  em .TXT, .RTX e .RTT, e CSV em .CSV. O nome exibido do RTTTL sai
	  do cabeçalho; o do CSV é o do arquivo, sem a extensão. Ver
	  src/storage.c.

config VITROLINHA_STORAGE_FAKE
	bool "Faixas embutidas no binario (implementacao de mentira)"
	help
	  Duas faixas RTTTL embutidas, sem cartão e sem sistema de arquivos.
	  Ver src/storage_fake.c.

config VITROLINHA_STORAGE_HOST
	bool "Faixas de uma pasta do computador"
	depends on BOARD_NATIVE_SIM && EXTERNAL_LIBC
	help
	  Lista as faixas da pasta em VITROLINHA_MUSIC_DIR, ou de
	  fixtures/music relativo ao diretório de execução, pela libc do
	  computador. Só existe no simulador. Ver src/storage_host.c.

endchoice

config VITROLINHA_TRANSPOSE_MIN_HZ
	int "Limiar da transposição por oitavas, em Hz (0 desliga)"
	range 0 20000
	default 0
	help
	  Um piezo é fraco abaixo de algumas centenas de hertz: as notas
	  graves saem mais baixas, e a melodia, com volume irregular. Com o
	  limiar ligado, o parser RTTTL sobe a faixa inteira em oitavas
	  completas até a nota mais grave alcançá-lo, preservando os
	  intervalos, e sem que a mais aguda passe do que o buzzer toca.

	  Desligado até a etapa E1 medir a resposta do piezo da placa: o
	  limiar sai dessa medição, e não de estimativa. O CSV nunca é
	  transposto, porque o arquivo de calibração tem de tocar o que diz.

config VITROLINHA_PLAYER
	bool
	default y
	depends on POLL
	depends on PWM || (BOARD_NATIVE_SIM && EXTERNAL_LIBC)
	help
	  Liga o player e o loader. Sem prompt: é ligado sozinho onde os
	  dois podem existir, e é a única condição que decide isso — o
	  src/CMakeLists.txt compila player.c e loader.c por ela, e o
	  src/main.c põe a reprodução de pé por ela.

	  Exige uma saída de tom: o PWM (na placa, o buzzer; em
	  tests/tone_pwm/, o PWM de mentira do Zephyr) ou, no simulador com
	  a libc do computador, a captura em memória do tone_trace. Exige
	  também `CONFIG_POLL`: o player espera comando e resultado de carga
	  num mesmo `k_poll`.

	  Um teste só a enxerga se o Kconfig dele fizer `rsource` deste
	  arquivo; sem isso o player fica fora do build dele.

config VITROLINHA_AUTO_ADVANCE
	bool "Avanco automatico para a faixa seguinte (RF09)"
	default y
	help
	  No fim da faixa, em vez de parar, o player carrega a faixa
	  seguinte da biblioteca, pulando as marcadas com `!`.

	  O avanço segue a ordem da lista e para na última faixa válida: não
	  dá a volta. Com uma única faixa válida, ela toca uma vez e para.
	  Com o cartão fora não há vizinha, e a faixa em RAM termina e para.

	  Quem detecta o fim é o callback do temporizador, em interrupção;
	  ele só sinaliza, e quem pede a carga é a thread `player`. Ver
	  src/player.c.

config VITROLINHA_LAST_TRACK
	bool "Lembrar a ultima faixa entre reinicializacoes (RF10)"
	depends on SETTINGS
	default y
	help
	  Grava a última faixa escolhida pelo subsistema `settings`, na
	  flash interna — nunca no cartão, cujo caminho de escrita no
	  sdhc_spi tem um laço de espera sem teto. No boot, com a biblioteca
	  pronta, a faixa volta como seleção, sem tocar.

	  A gravação mora numa thread de prioridade mínima, com debounce, e
	  só acontece com o player fora de PLAYER_PLAYING: no RP2350 o
	  driver de flash trava as interrupções durante a escrita, o que
	  atrasaria a próxima nota. Ver src/last_track.c.

config VITROLINHA_STATUS_LED
	bool "Estado da reproducao nos LEDs RGB (RF11)"
	depends on LED_STRIP
	default y if $(dt_alias_enabled,led-strip)
	help
	  Pinta a fita do alias `led-strip` — na ZBook P2, os quatro WS2812
	  do GPIO 31, via PIO1 — com o estado do instantâneo: verde tocando,
	  âmbar pausado, vermelho com erro de carga ou sem biblioteca, e
	  apagado parado. Lê o instantâneo a taxa fixa numa thread de baixa
	  prioridade; nada no callback do temporizador. Ver src/status_led.c.

endmenu
