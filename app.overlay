/*
 * Sobreposição comum aos dois alvos de compilação.
 *
 * O que é específico de cada um mora em boards/: a ZBook P2 em
 * boards/zbook_rp2350b_m33_p2.overlay, o simulador em
 * boards/native_sim.overlay. Aqui fica só o que vale para os dois — hoje, a
 * ponte entre o subsistema `input` e o dispositivo de entrada do LVGL, que é
 * idêntica nos dois porque ambos entregam os mesmos códigos de evento.
 *
 * SPDX-License-Identifier: Apache-2.0
 */

#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	/*
	 * Ponte declarativa entre o subsistema `input` do Zephyr e o
	 * dispositivo de entrada do LVGL.
	 *
	 * Sem a propriedade `input`, o nó assina todos os dispositivos de
	 * entrada e guarda apenas os dois códigos declarados aqui, ignorando
	 * os quatro botões de transporte. É exatamente a divisão desejada:
	 * encoder para o grupo de foco do LVGL, botões para a fila de
	 * comandos própria.
	 *
	 * Atenção: isto cria o indev, não o grupo de foco. Criar o grupo e
	 * amarrá-lo ao indev é da aplicação (issue #25) — sem isso o encoder
	 * gera eventos, o LVGL os recebe, e nada se move na tela.
	 */
	lvgl_encoder_input: lvgl_encoder_input {
		compatible = "zephyr,lvgl-encoder-input";
		rotation-input-code = <INPUT_REL_WHEEL>;
		button-input-code = <INPUT_KEY_ENTER>;
	};
};
