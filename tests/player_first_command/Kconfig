# Parâmetros dos cenários deste teste, um por processo (ver testcase.yaml).
#
# O que se testa aqui só acontece uma vez por processo: o player começa sem
# faixa uma vez. Cada cenário é por isso um binário próprio.

config TEST_CARD
	bool "Varrer a biblioteca de mentira, de duas faixas, antes do comando"
	default y

config TEST_REJECT_ALL
	bool "Recusar as duas faixas depois de varrer, como se o parser as rejeitasse"

config TEST_FIRST_COMMAND
	int "Primeiro comando, como valor de enum cmd_kind"
	default 0

config TEST_EXPECTED_TRACK
	int "Faixa do instantâneo depois do comando; -1 é TRACK_NONE"
	default 0

# As opções do projeto: é delas que sai CONFIG_VITROLINHA_PLAYER, sem a qual
# src/CMakeLists.txt deixaria player e loader fora deste teste.
rsource "../../Kconfig.vitrolinha"

source "Kconfig.zephyr"
