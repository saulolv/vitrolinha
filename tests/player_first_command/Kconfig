# Parâmetros dos cenários deste teste, um por processo (ver testcase.yaml).
#
# O que se testa aqui só acontece uma vez por processo: o player começa sem
# faixa, e player_init() fixa o tamanho da biblioteca até o fim. Cada cenário
# é por isso um binário próprio.

config TEST_LIBRARY_COUNT
	int "Faixas informadas a player_init()"
	default 3

config TEST_FIRST_COMMAND
	int "Primeiro comando, como valor de enum cmd_kind"
	default 0

config TEST_EXPECTED_TRACK
	int "Faixa do instantâneo depois do comando; -1 é TRACK_NONE"
	default 0

source "Kconfig.zephyr"
